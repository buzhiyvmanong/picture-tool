<Window x:Class="PictureTool.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Picture Tool"
        Width="520"
        Height="420"
        MinWidth="480"
        MinHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="欢迎使用 Picture Tool"
                 Foreground="{StaticResource TextBrush}"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="启动后会常驻系统托盘，可通过快捷键或托盘菜单使用。"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,20,0,0"
            Padding="16"
            Background="White"
            BorderBrush="#E4E7EC"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <TextBlock Text="常用操作"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}"
                   LineHeight="24">
          <Run Text="• 区域截图：" /><Run x:Name="CaptureHotkeyRun" FontWeight="SemiBold" /><LineBreak />
          <Run Text="• 贴图到屏幕：" /><Run x:Name="PasteHotkeyRun" FontWeight="SemiBold" /><LineBreak />
          <Run Text="• 双击托盘图标打开主面板" /><LineBreak />
          <Run Text="• 关闭主窗口只会隐藏到托盘，不会退出程序" /><LineBreak />
          <Run Text="• 滚动截图、提取文字、历史记录等功能可在主面板和托盘菜单中找到" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Button Grid.Row="2"
            Content="开始使用"
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            MinWidth="96"
            IsDefault="True"
            Click="Start_Click" />
  </Grid>
</Window>
