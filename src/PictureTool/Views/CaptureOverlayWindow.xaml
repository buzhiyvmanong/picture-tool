<Window x:Class="PictureTool.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross">
  <Window.Resources>
    <Style x:Key="ModeButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="96" />
      <Setter Property="Height"
              Value="32" />
      <Setter Property="Margin"
              Value="2" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="FontFamily"
              Value="Microsoft YaHei UI" />
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="Foreground"
              Value="#344054" />
      <Setter Property="Background"
              Value="#F8FAFC" />
      <Setter Property="BorderBrush"
              Value="#D0D5DD" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="ToolbarButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="36" />
      <Setter Property="Height"
              Value="34" />
      <Setter Property="Margin"
              Value="2" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="FontFamily"
              Value="Segoe UI Symbol" />
      <Setter Property="FontSize"
              Value="18" />
      <Setter Property="Foreground"
              Value="#344054" />
      <Setter Property="Background"
              Value="#F8FAFC" />
      <Setter Property="BorderBrush"
              Value="#D0D5DD" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="ScrollAutoButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="112" />
      <Setter Property="Height"
              Value="34" />
      <Setter Property="Margin"
              Value="2" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="FontFamily"
              Value="Microsoft YaHei UI" />
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="Foreground"
              Value="#344054" />
      <Setter Property="Background"
              Value="#F8FAFC" />
      <Setter Property="BorderBrush"
              Value="#D0D5DD" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="ColorButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="24" />
      <Setter Property="Height"
              Value="24" />
      <Setter Property="Margin"
              Value="3,5" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="BorderBrush"
              Value="#D0D5DD" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="StrokeButtonStyle"
           TargetType="Button">
      <Setter Property="Width"
              Value="34" />
      <Setter Property="Height"
              Value="28" />
      <Setter Property="Margin"
              Value="2" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="FontFamily"
              Value="Microsoft YaHei UI" />
      <Setter Property="FontSize"
              Value="12" />
      <Setter Property="Foreground"
              Value="#344054" />
      <Setter Property="Background"
              Value="#F8FAFC" />
      <Setter Property="BorderBrush"
              Value="#D0D5DD" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>
  </Window.Resources>

  <Canvas x:Name="RootCanvas"
          Focusable="True"
          PreviewMouseLeftButtonDown="RootCanvas_PreviewMouseLeftButtonDown"
          PreviewMouseMove="RootCanvas_PreviewMouseMove"
          PreviewMouseLeftButtonUp="RootCanvas_PreviewMouseLeftButtonUp"
          PreviewMouseWheel="RootCanvas_PreviewMouseWheel"
          KeyDown="RootCanvas_KeyDown">
    <Image x:Name="ScreenshotImage"
           Stretch="Fill" />

    <Rectangle x:Name="DimTop"
               Fill="#66000000"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    <Rectangle x:Name="DimLeft"
               Fill="#66000000"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    <Rectangle x:Name="DimRight"
               Fill="#66000000"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    <Rectangle x:Name="DimBottom"
               Fill="#66000000"
               IsHitTestVisible="False"
               Visibility="Collapsed" />

    <InkCanvas x:Name="AnnotationInkCanvas"
               Background="Transparent"
               Visibility="Collapsed"
               PreviewMouseLeftButtonDown="AnnotationInkCanvas_PreviewMouseLeftButtonDown"
               PreviewMouseMove="AnnotationInkCanvas_PreviewMouseMove"
               PreviewMouseLeftButtonUp="AnnotationInkCanvas_PreviewMouseLeftButtonUp" />

    <Rectangle x:Name="SelectionRect"
               Stroke="#69C7FF"
               StrokeThickness="2"
               Fill="Transparent"
               IsHitTestVisible="False"
               Visibility="Collapsed" />

    <TextBlock x:Name="SizeBadge"
               Background="#CCF8FAFC"
               Foreground="#344054"
               FontSize="13"
               Padding="6,3"
               Visibility="Collapsed" />

    <Border x:Name="ScrollPreviewPanel"
            Background="#D9F8FAFC"
            BorderBrush="#69C7FF"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="Collapsed">
      <Image x:Name="ScrollPreviewImage"
             Stretch="Uniform"
             IsHitTestVisible="False" />
    </Border>

    <TextBlock x:Name="ScrollWarningText"
               Text="滚动速度过快，请重新回到截图位置，缓慢滑动"
               Background="#F79009"
               Foreground="#101828"
               FontSize="14"
               FontWeight="SemiBold"
               Padding="10,6"
               TextWrapping="Wrap"
               MaxWidth="420"
               Visibility="Collapsed" />

    <Canvas x:Name="SelectionChrome"
            Visibility="Collapsed">
      <Rectangle x:Name="MoveSurface"
                 Fill="Transparent"
                 MouseLeftButtonDown="MoveSurface_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleTopLeft"
               Tag="TopLeft"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleTop"
               Tag="Top"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleTopRight"
               Tag="TopRight"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleRight"
               Tag="Right"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleBottomRight"
               Tag="BottomRight"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleBottom"
               Tag="Bottom"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleBottomLeft"
               Tag="BottomLeft"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
      <Ellipse x:Name="HandleLeft"
               Tag="Left"
               Width="12"
               Height="12"
               Fill="#F8FAFC"
               Stroke="#69C7FF"
               StrokeThickness="2"
               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
    </Canvas>

    <Border x:Name="ModeBar"
            Background="#F8FAFC"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            Canvas.Top="16"
            Panel.ZIndex="20">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16"
                          ShadowDepth="2"
                          Opacity="0.22" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ScreenshotModeButton"
                Content="截图"
                Style="{StaticResource ModeButtonStyle}"
                Click="ScreenshotMode_Click" />
        <Button x:Name="ScrollModeButton"
                Content="滚动截图"
                Style="{StaticResource ModeButtonStyle}"
                Click="ScrollMode_Click" />
      </StackPanel>
    </Border>

    <Border x:Name="ToolOptionsBar"
            Background="#F8FAFC"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14"
                          ShadowDepth="2"
                          Opacity="0.18" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="ColorOptionsPanel"
                    Orientation="Horizontal">
          <Button x:Name="ColorRedButton"
                  Tag="#F04438"
                  Background="#F04438"
                  ToolTip="Red"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
          <Button x:Name="ColorYellowButton"
                  Tag="#F79009"
                  Background="#F79009"
                  ToolTip="Orange"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
          <Button x:Name="ColorGreenButton"
                  Tag="#12B76A"
                  Background="#12B76A"
                  ToolTip="Green"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
          <Button x:Name="ColorBlueButton"
                  Tag="#2E90FA"
                  Background="#2E90FA"
                  ToolTip="Blue"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
          <Button x:Name="ColorWhiteButton"
                  Tag="#FFFFFF"
                  Background="#FFFFFF"
                  ToolTip="White"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
          <Button x:Name="ColorBlackButton"
                  Tag="#101828"
                  Background="#101828"
                  ToolTip="Black"
                  Style="{StaticResource ColorButtonStyle}"
                  Click="Color_Click" />
        </StackPanel>

        <Rectangle x:Name="StrokeOptionsDivider"
                   Width="1"
                   Height="26"
                   Fill="#D0D5DD"
                   Margin="7,4" />

        <StackPanel x:Name="StrokeOptionsPanel"
                    Orientation="Horizontal">
          <Button x:Name="StrokeThinButton"
                  Content="细"
                  Tag="2"
                  ToolTip="Thin"
                  Style="{StaticResource StrokeButtonStyle}"
                  Click="StrokeWidth_Click" />
          <Button x:Name="StrokeMediumButton"
                  Content="中"
                  Tag="4"
                  ToolTip="Medium"
                  Style="{StaticResource StrokeButtonStyle}"
                  Click="StrokeWidth_Click" />
          <Button x:Name="StrokeBoldButton"
                  Content="粗"
                  Tag="8"
                  ToolTip="Bold"
                  Style="{StaticResource StrokeButtonStyle}"
                  Click="StrokeWidth_Click" />
        </StackPanel>

        <StackPanel x:Name="TextSizeOptionsPanel"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
          <TextBlock Text="字号"
                     VerticalAlignment="Center"
                     Margin="8,0,6,0"
                     Foreground="#344054" />
          <ComboBox x:Name="TextSizeComboBox"
                    Width="78"
                    Height="28"
                    SelectedIndex="1"
                    SelectionChanged="TextSize_SelectionChanged">
            <ComboBoxItem Content="小"
                          Tag="18" />
            <ComboBoxItem Content="中"
                          Tag="24" />
            <ComboBoxItem Content="大"
                          Tag="32" />
            <ComboBoxItem Content="特大"
                          Tag="44" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="Toolbar"
            Background="#F8FAFC"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,7"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.22" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="MoveButton"
                Content="&#x2725;"
                ToolTip="Move"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Move_Click" />
        <Button x:Name="RectangleButton"
                Content="&#x25A1;"
                ToolTip="Rectangle"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Rectangle_Click" />
        <Button x:Name="EllipseButton"
                Content="&#x25CB;"
                ToolTip="Ellipse"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Ellipse_Click" />
        <Button x:Name="LineButton"
                Content="/"
                ToolTip="Line"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Line_Click" />
        <Button x:Name="ArrowButton"
                Content="&#x2198;"
                ToolTip="Arrow"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Arrow_Click" />
        <Button x:Name="PenButton"
                Content="&#x270E;"
                ToolTip="Pen"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Pen_Click" />
        <Button x:Name="TextButton"
                Content="A"
                ToolTip="Text"
                FontFamily="Segoe UI"
                FontWeight="SemiBold"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Text_Click" />
        <Button x:Name="MosaicButton"
                Content="&#x25A6;"
                ToolTip="Mosaic"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Mosaic_Click" />
        <Button x:Name="EraserButton"
                Content="&#x232B;"
                ToolTip="Eraser"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Eraser_Click" />
        <Button x:Name="ScrollCaptureButton"
                Content="&#x2702;"
                ToolTip="滚动截图"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="ScrollCapture_Click" />
        <Rectangle Width="1"
                   Height="28"
                   Fill="#D0D5DD"
                   Margin="7,3" />
        <Button Content="&#x21E9;"
                ToolTip="Save"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Save_Click" />
        <Button Content="&#x2398;"
                ToolTip="Copy"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Copy_Click" />
        <Button Content="P"
                ToolTip="Pin"
                FontFamily="Segoe UI"
                FontWeight="SemiBold"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Pin_Click" />
        <Button Content="&#x21B6;"
                ToolTip="Undo"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Undo_Click" />
        <Button Content="&#x2715;"
                ToolTip="Cancel"
                Foreground="#B42318"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Cancel_Click" />
        <Button Content="&#x2713;"
                ToolTip="Done"
                Foreground="#027A48"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="Accept_Click" />
      </StackPanel>
    </Border>

    <Border x:Name="ScrollToolbar"
            Background="#F8FAFC"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,7"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.22" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="AutoScrollButton"
                Content="自动滚动"
                ToolTip="自动滚动 / 暂停"
                Style="{StaticResource ScrollAutoButtonStyle}"
                Click="AutoScroll_Click" />
        <Rectangle Width="1"
                   Height="28"
                   Fill="#D0D5DD"
                   Margin="7,3" />
        <Button x:Name="SaveScrollButton"
                Content="&#x21E9;"
                ToolTip="保存长图"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="SaveScroll_Click" />
        <Button x:Name="AnnotateScrollButton"
                Content="A"
                ToolTip="完成并标注"
                FontFamily="Segoe UI"
                FontWeight="SemiBold"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="AnnotateScroll_Click" />
        <Rectangle Width="1"
                   Height="28"
                   Fill="#D0D5DD"
                   Margin="7,3" />
        <Button x:Name="CancelScrollButton"
                Content="✕"
                ToolTip="取消"
                Foreground="#B42318"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="CancelScroll_Click" />
        <Button x:Name="FinishScrollButton"
                Content="✓"
                ToolTip="确定并复制"
                Foreground="#027A48"
                Style="{StaticResource ToolbarButtonStyle}"
                Click="FinishScroll_Click" />
      </StackPanel>
    </Border>
  </Canvas>
</Window>
