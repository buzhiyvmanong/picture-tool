<Window x:Class="PictureTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picture Tool"
        Width="430"
        Height="250"
        MinWidth="390"
        MinHeight="230"
        Background="{StaticResource PanelBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Picture Tool"
                 Foreground="{StaticResource TextBrush}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="低内存截图、标注、贴图工具"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Vertical"
                VerticalAlignment="Center">
      <WrapPanel>
        <Button Content="截图"
                MinWidth="82"
                Click="CaptureArea_Click" />
        <Button Content="贴图"
                MinWidth="82"
                Click="PasteImage_Click" />
        <Button Content="快捷键设置"
                MinWidth="112"
                Click="Settings_Click" />
      </WrapPanel>
      <TextBlock x:Name="HotkeySummaryText"
                 Text="快捷键加载中..."
                 Margin="0,16,0,0"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Foreground="{StaticResource MutedTextBrush}"
               Text="托盘已启用。" />
  </Grid>
</Window>
