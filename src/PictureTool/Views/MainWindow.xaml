<Window x:Class="PictureTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picture Tool"
        Width="580"
        Height="420"
        MinWidth="480"
        MinHeight="350"
        Background="{StaticResource PanelBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Picture Tool"
                 Foreground="{StaticResource TextBrush}"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="低内存截图、标注、贴图工具"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Margin="0,16,0,0">
      <WrapPanel>
        <Button Content="截图"
                MinWidth="82"
                Click="CaptureArea_Click" />
        <Button Content="滚动截图"
                MinWidth="96"
                Click="ScrollCapture_Click" />
        <Button Content="贴图"
                MinWidth="82"
                Click="PasteImage_Click" />
        <Button Content="设置"
                MinWidth="82"
                Click="Settings_Click" />
        <Button Content="使用指引"
                MinWidth="96"
                Click="UsageGuide_Click" />
      </WrapPanel>
      <TextBlock x:Name="HotkeySummaryText"
                 Text="快捷键加载中..."
                 Margin="0,10,0,0"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="2"
          Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <TextBlock Text="最近截图"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <Button Content="清空"
                HorizontalAlignment="Right"
                Click="ClearHistory_Click"
                Padding="8,2"
                FontSize="12" />
      </DockPanel>
      <ListBox x:Name="HistoryList"
               Grid.Row="1"
               Margin="0,8,0,0"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="HistoryList_MouseDoubleClick">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="100"
                        Margin="4">
              <Border BorderBrush="#D0D5DD"
                      BorderThickness="1"
                      CornerRadius="4"
                      Height="70"
                      ClipToBounds="True">
                <Image Stretch="UniformToFill">
                  <Image.Source>
                    <BitmapImage UriSource="{Binding FileUri}"
                                 DecodePixelWidth="120"
                                 CacheOption="OnLoad"
                                 CreateOptions="IgnoreColorProfile" />
                  </Image.Source>
                </Image>
              </Border>
              <TextBlock Text="{Binding DisplayTime}"
                         FontSize="11"
                         Foreground="{StaticResource MutedTextBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,4,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <TextBlock x:Name="StatusText"
               Grid.Row="3"
               Margin="0,8,0,0"
               Foreground="{StaticResource MutedTextBrush}"
               Text="托盘已启用。" />
  </Grid>
</Window>
