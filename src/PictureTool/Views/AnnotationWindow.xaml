<Window x:Class="PictureTool.Views.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注"
        Width="980"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        Background="#F7F8FA"
        PreviewKeyDown="AnnotationWindow_PreviewKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="White"
            BorderBrush="#D0D5DD"
            BorderThickness="0,0,0,1"
            Padding="12">
      <StackPanel Orientation="Horizontal">
        <Button Content="画笔"
                Click="Pen_Click" />
        <Button Content="矩形"
                Click="Rectangle_Click" />
        <Button Content="橡皮擦"
                Click="Eraser_Click" />
        <Button Content="撤销"
                Click="Undo_Click" />
        <Button Content="清空"
                Click="Clear_Click" />
        <Button Content="贴到屏幕"
                Click="Pin_Click" />
        <Button Content="复制"
                Click="Copy_Click" />
        <Button Content="保存"
                Click="Save_Click" />
        <Button Content="提取文字"
                Click="Ocr_Click" />
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <Grid x:Name="ImageHost"
            Background="#E4E7EC">
        <Image x:Name="SourceImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top" />
        <InkCanvas x:Name="AnnotationInkCanvas"
                   Background="Transparent"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   PreviewMouseLeftButtonDown="AnnotationInkCanvas_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="AnnotationInkCanvas_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="AnnotationInkCanvas_PreviewMouseLeftButtonUp" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
