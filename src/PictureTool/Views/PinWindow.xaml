<Window x:Class="PictureTool.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="96"
        MinHeight="72">
  <Border x:Name="PinFrame"
          BorderBrush="#475467"
          BorderThickness="1"
          Background="#01FFFFFF"
          MouseLeftButtonDown="PinFrame_MouseLeftButtonDown">
    <Border.ContextMenu>
      <ContextMenu Opened="PinContextMenu_Opened">
        <MenuItem Header="复制图片"
                  Click="CopyPin_Click" />
        <MenuItem Header="保存为..."
                  Click="SavePin_Click" />
        <Separator />
        <MenuItem x:Name="TopmostMenuItem"
                  Header="取消置顶"
                  Click="ToggleTopmost_Click" />
        <MenuItem Header="提取文字"
                  Click="ExtractText_Click" />
        <Separator />
        <MenuItem Header="关闭贴图"
                  Click="CloseMenu_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="PinContent">
      <Image x:Name="PinnedImage"
             Stretch="Fill"
             HorizontalAlignment="Left"
             VerticalAlignment="Top" />
      <Button Content="×"
              Width="28"
              Height="28"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="6"
              Click="Close_Click" />
    </Grid>
  </Border>
</Window>
