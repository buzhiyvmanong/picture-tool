<Window x:Class="PictureTool.Views.ScrollCaptureControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
  <Border Background="#F8FAFC"
          BorderBrush="#D0D5DD"
          BorderThickness="1"
          CornerRadius="8"
          Padding="10,8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16"
                        ShadowDepth="2"
                        Opacity="0.22" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="StatusText"
                 Text="手动滚动：已截取 1 屏"
                 Foreground="#344054"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0" />
      <Button x:Name="ManualButton"
              Content="追加当前屏"
              Width="92"
              Click="Manual_Click" />
      <Button x:Name="AutoButton"
              Content="自动滚动"
              Width="86"
              Click="Auto_Click" />
      <Button x:Name="FinishButton"
              Content="完成"
              Width="64"
              Click="Finish_Click" />
      <Button x:Name="CancelButton"
              Content="取消"
              Width="64"
              Click="Cancel_Click" />
    </StackPanel>
  </Border>
</Window>
