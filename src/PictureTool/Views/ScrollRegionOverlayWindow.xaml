<Window x:Class="PictureTool.Views.ScrollRegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross">
  <Canvas x:Name="RootCanvas"
          Focusable="True"
          MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
          MouseMove="RootCanvas_MouseMove"
          MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
          KeyDown="RootCanvas_KeyDown">
    <Image x:Name="ScreenshotImage"
           Stretch="Fill" />
    <Rectangle x:Name="DimLayer"
               Fill="#66000000"
               IsHitTestVisible="False" />
    <Rectangle x:Name="SelectionRect"
               Stroke="#69C7FF"
               StrokeThickness="2"
               Fill="#2269C7FF"
               Visibility="Collapsed" />
    <TextBlock x:Name="HintText"
               Text="拖拽选择滚动截图区域，Esc 取消"
               Foreground="White"
               Background="#AA101828"
               Padding="10,6"
               FontSize="15"
               Canvas.Left="24"
               Canvas.Top="24" />
    <TextBlock x:Name="SizeBadge"
               Background="#CCF8FAFC"
               Foreground="#344054"
               FontSize="13"
               Padding="6,3"
               Visibility="Collapsed" />
  </Canvas>
</Window>
