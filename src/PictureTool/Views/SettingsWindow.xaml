<Window x:Class="PictureTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        Height="560"
        MinWidth="480"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="设置"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="快捷键、启动行为与历史记录。"
                   Margin="0,6,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,20,0,0">
        <TextBlock Text="快捷键"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="区域截图" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
          <TextBox x:Name="CaptureAreaHotkeyBox"
                   Grid.Column="1"
                   Height="36"
                   IsReadOnly="True"
                   VerticalContentAlignment="Center"
                   PreviewKeyDown="CaptureAreaHotkeyBox_PreviewKeyDown" />
          <TextBlock Grid.Row="1" Text="粘贴图片" Margin="0,14,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
          <TextBox x:Name="PasteImageHotkeyBox"
                   Grid.Row="1"
                   Grid.Column="1"
                   Height="36"
                   Margin="0,14,0,0"
                   IsReadOnly="True"
                   VerticalContentAlignment="Center"
                   PreviewKeyDown="PasteImageHotkeyBox_PreviewKeyDown" />
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="0,20,0,0">
        <TextBlock Text="常规"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Margin="0,12,0,0"
                  Content="开机自启动" />
        <CheckBox x:Name="CheckUpdatesCheckBox"
                  Margin="0,10,0,0"
                  Content="启动时检查更新" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="历史记录上限"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextBrush}" />
          <TextBox x:Name="HistoryMaxItemsBox"
                   Width="72"
                   Height="32"
                   Margin="12,0,0,0"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center" />
          <TextBlock Text="条（5-200）"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 Grid.Row="3"
                 Margin="0,16,0,16"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource MutedTextBrush}"
                 Text="建议使用 Ctrl / Alt / Shift / Win 加一个字母键。" />

      <StackPanel Grid.Row="4"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
        <Button Content="恢复默认" Click="Reset_Click" />
        <Button Content="取消" IsCancel="True" />
        <Button Content="保存" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
