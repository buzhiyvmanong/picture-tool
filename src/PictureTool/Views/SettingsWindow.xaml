<Window x:Class="PictureTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置"
        Width="460"
        Height="310"
        MinWidth="420"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="快捷键设置"
                 Foreground="{StaticResource TextBrush}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="点击输入框后，直接按下新的组合键。"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1"
          Margin="0,24,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="区域截图"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource TextBrush}" />
      <TextBox x:Name="CaptureAreaHotkeyBox"
               Grid.Column="1"
               Height="36"
               IsReadOnly="True"
               VerticalContentAlignment="Center"
               PreviewKeyDown="CaptureAreaHotkeyBox_PreviewKeyDown" />

      <TextBlock Grid.Row="1"
                 Text="粘贴图片"
                 Margin="0,14,0,0"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource TextBrush}" />
      <TextBox x:Name="PasteImageHotkeyBox"
               Grid.Row="1"
               Grid.Column="1"
               Height="36"
               Margin="0,14,0,0"
               IsReadOnly="True"
               VerticalContentAlignment="Center"
               PreviewKeyDown="PasteImageHotkeyBox_PreviewKeyDown" />
    </Grid>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Margin="0,8,0,16"
               Foreground="{StaticResource MutedTextBrush}"
               Text="建议使用 Ctrl / Alt / Shift / Win 加一个字母键。" />

    <StackPanel Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button Content="恢复默认"
              Click="Reset_Click" />
      <Button Content="取消"
              IsCancel="True" />
      <Button Content="保存"
              IsDefault="True"
              Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>

